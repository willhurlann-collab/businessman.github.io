<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Businessman — Explorez votre avenir professionnel</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: white;
            min-height: 100vh;
        }

        header {
            text-align: center;
            padding: 60px 20px 30px;
        }

        header h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        header h1 span {
            color: #38bdf8;
        }

        header p {
            max-width: 700px;
            margin: auto;
            color: #cbd5e1;
            font-size: 18px;
            line-height: 1.6;
        }

        .container {
            width: 90%;
            max-width: 750px;
            margin: 30px auto 70px;
        }

        .card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 20px;
            padding: 35px;
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-bottom: 10px;
        }

        .intro {
            color: #cbd5e1;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .question {
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin-bottom: 9px;
            font-weight: bold;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 14px;
            border: 1px solid #475569;
            border-radius: 10px;
            background: #0f172a;
            color: white;
            font-size: 16px;
            outline: none;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: #38bdf8;
        }

        textarea {
            min-height: 110px;
            resize: vertical;
        }

        .metier {
            border: 2px solid #38bdf8;
        }

        button {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 10px;
            background: #38bdf8;
            color: #082f49;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover {
            background: #7dd3fc;
            transform: translateY(-2px);
        }

        #resultat {
            display: none;
            margin-top: 30px;
            padding: 25px;
            border-radius: 15px;
            background: #0f172a;
            border: 1px solid #334155;
        }

        #resultat h3 {
            color: #38bdf8;
            margin-bottom: 15px;
        }

        .info {
            margin: 8px 0;
            color: #cbd5e1;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #64748b;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 36px;
            }

            .card {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1><span>Businessman</span></h1>

    <p>
        Explorez votre avenir professionnel avant de vous engager.
        Découvrez les opportunités, les avantages, les contraintes,
        les salaires, les débouchés et les possibilités d'évolution.
    </p>
</header>

<main class="container">

    <div class="card">

        <h2>Construisons votre projet professionnel</h2>

        <p class="intro">
            Répondez à quelques questions afin que Businessman puisse
            mieux comprendre votre profil et votre projet.
        </p>

        <!-- QUESTION 1 -->
        <div class="question">
            <label for="nom">1. Comment souhaitez-vous être appelé ?</label>

            <input
                type="text"
                id="nom"
                placeholder="Exemple : Will"
                required
            >
        </div>

        <!-- QUESTION 2 -->
        <div class="question">
            <label for="age">2. Quel âge avez-vous ?</label>

            <input
                type="number"
                id="age"
                min="13"
                max="100"
                placeholder="Exemple : 20"
                required
            >
        </div>

        <!-- QUESTION 3 -->
        <div class="question">
            <label for="projet">
                3. Que prévoyez-vous de faire dans les prochaines années ?
            </label>

            <textarea
                id="projet"
                placeholder="Exemple : poursuivre mes études, créer une entreprise, travailler dans la technologie..."
            ></textarea>
        </div>

        <!-- QUESTION 4 -->
        <div class="question">
            <label for="motivation">
                4. Qu'est-ce qui vous motive principalement ?
            </label>

            <select id="motivation">
                <option value="">Sélectionnez une motivation</option>
                <option>Gagner un bon revenu</option>
                <option>Avoir un métier passionnant</option>
                <option>Aider les autres</option>
                <option>Créer mon entreprise</option>
                <option>Innover et créer</option>
                <option>Avoir une carrière internationale</option>
                <option>Avoir une grande stabilité professionnelle</option>
                <option>Autre</option>
            </select>
        </div>

        <!-- QUESTION 5 -->
        <div class="question">
            <label for="metier">
                5. Quel métier souhaitez-vous explorer ?
            </label>

            <input
                class="metier"
                type="text"
                id="metier"
                placeholder="Exemple : ingénieur en intelligence artificielle"
                required
            >
        </div>

        <button onclick="analyserProjet()">
            Analyser mon projet
        </button>

        <div id="resultat">
            <h3>Votre projet</h3>

            <p class="info">
                Bonjour <strong id="resultatNom"></strong> !
            </p>

            <p class="info">
                Âge : <strong id="resultatAge"></strong> ans
            </p>

            <p class="info">
                Projet :
                <strong id="resultatProjet"></strong>
            </p>

            <p class="info">
                Motivation :
                <strong id="resultatMotivation"></strong>
            </p>

            <p class="info">
                Métier recherché :
                <strong id="resultatMetier"></strong>
            </p>

            <br>

            <p>
                Votre profil est prêt à être analysé.
                La prochaine étape sera d'afficher les
                informations concernant ce métier :
                salaire, études, avantages, contraintes,
                débouchés et évolution.
            </p>
        </div>

    </div>

</main>

<footer>
    © 2026 Businessman — Explorez votre avenir professionnel
</footer>


<script>

function analyserProjet() {

    const nom = document.getElementById("nom").value;
    const age = document.getElementById("age").value;
    const projet = document.getElementById("projet").value;
    const motivation = document.getElementById("motivation").value;
    const metier = document.getElementById("metier").value;

    if (!nom || !age || !metier) {
        alert("Veuillez renseigner votre nom, votre âge et le métier que vous souhaitez explorer.");
        return;
    }

    document.getElementById("resultatNom").textContent = nom;
    document.getElementById("resultatAge").textContent = age;
    document.getElementById("resultatProjet").textContent =
        projet || "Non renseigné";

    document.getElementById("resultatMotivation").textContent =
        motivation || "Non renseignée";

    document.getElementById("resultatMetier").textContent = metier;

    document.getElementById("resultat").style.display = "block";
}

</script>

</body>
</html>
